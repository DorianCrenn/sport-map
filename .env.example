# Copier ce fichier en .env.local et remplir les valeurs
# Variables à renseigner aussi dans Vercel → Project → Settings → Environment Variables

# ── Supabase ──────────────────────────────────────────────────────────────────
# Disponibles dans : Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...votre_cle_anon...

# ── Web Push ──────────────────────────────────────────────────────────────────
# Générer avec : npx web-push generate-vapid-keys
# Clé publique côté client (exposée)
VITE_VAPID_PUBLIC_KEY=votre_cle_vapid_publique_base64url
# Clé privée : à stocker UNIQUEMENT dans les secrets de la Edge Function Supabase
# (Supabase Dashboard → Edge Functions → Secrets → VAPID_PRIVATE_KEY)

# ── URL publique ──────────────────────────────────────────────────────────────
# Utilisée pour les balises og:image, sitemap et partages sociaux
VITE_APP_URL=https://sportlink.fr

# ── Sentry — monitoring erreurs prod ─────────────────────────────────────────
# Optionnel. Créer un projet sur sentry.io → Settings → Client Keys (DSN)
# Si vide : Sentry est désactivé (pas d'erreur au démarrage)
VITE_SENTRY_DSN=

# ── Stripe ────────────────────────────────────────────────────────────────────
# La clé publique Stripe n'est PAS nécessaire côté frontend (le paiement passe
# via les Edge Functions Supabase). Configurer dans :
# Supabase Dashboard → Edge Functions → Secrets :
#   STRIPE_SECRET_KEY     = sk_live_...
#   STRIPE_WEBHOOK_SECRET = whsec_...

# ── fal.ai — génération d'images IA ──────────────────────────────────────────
# Optionnel. Sans clé, Pollinations.ai (gratuit) est utilisé en fallback.
# Créer une clé sur fal.ai → Account → API Keys
# À configurer dans Supabase Edge Functions Secrets : FAL_API_KEY=...
# (Ne pas mettre ici — côté serveur uniquement)
