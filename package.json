{
  "name": "sport-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.js",
    "build": "vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "deploy": "bash scripts/deploy.sh",
    "deploy:skip-tests": "bash scripts/deploy.sh --skip-tests",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:preview": "playwright test --project='Desktop Chrome 1440' --project='iPhone SE'",
    "test:visual": "playwright test e2e/visual/visual.spec.js --project='Desktop Chrome 1440'",
    "test:visual:update": "playwright test e2e/visual/visual.spec.js --project='Desktop Chrome 1440' --update-snapshots",
    "test:all": "npm run lint && npm run test:coverage && npm run test:e2e",
    "pwa:screenshots": "node scripts/generate-pwa-screenshots.js",
    "og:generate": "node scripts/generate-og.js",
    "audit:visual": "node scripts/visual-audit.js",
    "audit:buttons": "node scripts/button-visibility-audit.js",
    "qa:scan": "node scripts/qa-scan.js",
    "qa:report": "npm run test:coverage && npm run test:e2e && npm run qa:scan",
    "ci": "npm run lint && npm run test",
    "ci:full": "npm run lint && npm run test:coverage && npm run test:e2e",
    "prepare": "husky",
    "release": "standard-version && git push --follow-tags origin main",
    "release:minor": "standard-version --release-as minor && git push --follow-tags origin main",
    "release:major": "standard-version --release-as major && git push --follow-tags origin main"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix --max-warnings 50"
    ],
    "supabase/migrations/*.sql": [
      "echo 'Migration SQL — vérifier RLS + index manuellement avant supabase db push'"
    ]
  },
  "dependencies": {
    "@sentry/react": "^10.59.0",
    "@supabase/supabase-js": "^2.105.4",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.5",
    "framer-motion": "^12.38.0",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "react": "^19.2.5",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.5",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.5.2",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  }
}
